# Copy to .env and fill in real values (never commit .env)

OPENAI_API_KEY=
# AGVL_OPENAI_CHAT_MODEL=gpt-4o-mini
# AGVL_OPENAI_EMBED_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=

# Claude model id (Anthropic SDK)
# AGVL_CLAUDE_MODEL=claude-sonnet-4-20250514

# S7 human gate: non-interactive mode (pytest / servers); skips blocking input
AGVL_NON_INTERACTIVE=true

# When AGVL_NON_INTERACTIVE=true and domain is high-risk, optional verdict
# AGVL_HUMAN_VERDICT=approve
# AGVL_HUMAN_EDITED_RESPONSE=

# Legacy env (ignored by HumanGate; kept for older scripts)
AGVL_HUMAN_APPROVED=true

# Optional: override directory for S8 JSONL logs (defaults to agvl-pipeline/logs)
# AGVL_LOG_DIR=

# --- Vector RAG (S2): install requirements-ml.txt ---
# AGVL_VECTOR_BACKEND=none|chroma|faiss
# AGVL_VECTOR_TOP_K=5
# AGVL_CHROMA_COLLECTION=agvl_kb

# FAISS path uses sentence-transformers (see AGVL_EMBED_MODEL)
# AGVL_EMBED_MODEL=all-MiniLM-L6-v2

# --- Graph-RAG (S2): Neo4j + LangChain ---
# AGVL_GRAPH_RAG=true
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=
# Optional custom read query:
# AGVL_GRAPH_CYPHER=MATCH (n) RETURN n LIMIT 10

# --- LangSmith (S8 + full pipeline tracing) ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=agvl

# Default query when run_pipeline has no query key
# AGVL_DEFAULT_QUERY=
